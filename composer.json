{
    "name": "sohophp/sosecurity",
    "description": "Modular, framework-independent security helpers for PHP 7.2 through 8.5",
    "type": "library",
    "license": "MIT",
    "require": {"php": ">=7.2 <8.6", "ext-json": "*", "ext-hash": "*"},
    "autoload": {"psr-4": {"SoSecurity\\": "src/"}},
    "autoload-dev": {"psr-4": {"SoSecurity\\Tests\\": "tests/"}},
    "suggest": {"ext-session": "Native session helpers and SessionStore", "ext-gd": "Image CAPTCHA", "ext-redis": "Shared atomic Redis storage", "ext-curl": "Default Turnstile transport", "ext-pdo_mysql": "Shared atomic InnoDB storage", "ext-intl": "Optional explicit NFC input normalization", "ext-fileinfo": "Upload content MIME inspection"},
    "scripts": {"test": "@php tests/run.php", "lint": "@php bin/lint.php"},
    "archive": {"exclude": ["/vendor", "/tools", "/tests", "/bin", "/demo", "/.htaccess", "/.github", "/var", "/.phpstan-cache", "/.phpunit.cache", "/phpstan.neon", "/composer.lock", "/.env", "/.env.*", "/docs/requirements.md"]}
}
